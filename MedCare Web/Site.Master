<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MedCare_Web.Site" %>

<!DOCTYPE html>
<html>
<head runat="server">

    <title>MedCare Plus Hospital</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <link href="style.css"
          rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <nav class="navbar">

        <div class="logo">
            ⚕ MedCare <span>Plus</span>
        </div>

        <ul class="nav-links">

            <li><a href="Home.aspx">Home</a></li>

            <li><a href="Services.aspx">Services</a></li>

            <li><a href="Appointment.aspx">Appointment</a></li>

            <li><a href="Contact.aspx">Contact</a></li>

            <li><a href="Feedback.aspx">Feedback</a></li>

            <li><a href="Register.aspx" class="register-btn">Register</a>
            </li>
            <li><a href="Login.aspx" class="login-btn">Login</a>
            </li>
            <li><a href="AdminLogin.aspx" class="login-btn">Admin Portal</a>
            </li>

        </ul>

    </nav>

    <asp:ContentPlaceHolder ID="MainContent"
        runat="server">
    </asp:ContentPlaceHolder>

     <!-- ================= FOOTER SECTION ================= -->
    <footer style="background-color: #0f172a; color: #94a3b8; padding: 50px 20px 20px; margin-top: auto;">
    <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px;">
        
        <!-- Col 1: About & Emergency -->
        <div>
            <h3 style="color: #ffffff; margin-bottom: 15px; font-size: 18px;">MedCare Hospital</h3>
            <p style="font-size: 14px; line-height: 1.6;">Providing compassionate, world-class healthcare and modern medical treatment facilities.</p>
            <div style="margin-top: 15px; padding: 10px; background-color: #1e293b; border-left: 4px solid #ef4444; border-radius: 4px;">
                <span style="display: block; font-size: 11px; color: #ef4444; font-weight: bold; text-transform: uppercase;">24/7 Emergency</span>
                <a href="tel:18005550199" style="color: #ffffff; text-decoration: none; font-weight: bold; font-size: 16px;">08329606209</a>
            </div>
        </div>

        <!-- Col 2: Footer Quick Links (Duplicate/Extended Navigation) -->
        <div>
            <h4 style="color: #ffffff; margin-bottom: 15px; font-size: 15px;">Quick Links</h4>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 14px; line-height: 2.2;">
                <li><a href="Home.aspx" style="color: #94a3b8; text-decoration: none;">Home Page</a></li>
                <li><a href="Services.aspx" style="color: #94a3b8; text-decoration: none;">Medical Services</a></li>
                <li><a href="Appointment.aspx" style="color: #94a3b8; text-decoration: none;">Book Appointment</a></li>
                <li><a href="Feedback.aspx" style="color: #94a3b8; text-decoration: none;">Patient Feedback</a></li>
                <li><a href="Contact.aspx" style="color: #94a3b8; text-decoration: none;">Contact Us</a></li>
            </ul>
        </div>

        <!-- Col 3: Portal & Admin Access -->
        <div>
            <h4 style="color: #ffffff; margin-bottom: 15px; font-size: 15px;">Portals & Admin</h4>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 14px; line-height: 2.2;">
                <li><a href="Login.aspx" style="color: #94a3b8; text-decoration: none;">Patient Login</a></li>
                <li><a href="Register.aspx" style="color: #94a3b8; text-decoration: none;">New Patient Register</a></li>
                <li><a href="AdminLogin.aspx" style="color: #38bdf8; text-decoration: none; font-weight: 500;">🔒 Admin Portal</a></li>
            </ul>
        </div>

        <!-- Col 4: Location & Info -->
        <div>
            <h4 style="color: #ffffff; margin-bottom: 15px; font-size: 15px;">Hospital Location</h4>
            <p style="font-size: 14px; margin-bottom: 8px;">📍123 Healthcare Blvd, Medical District</p>
            <p style="font-size: 14px; margin-bottom: 8px;">✉️ medcarehospital@gmail.com</p>
            <p style="font-size: 14px;">🕒 OPD Hours: 8:00 AM – 8:00 PM</p>
        </div>

    </div>

    <!-- Bottom Copyright Bar -->
    <div style="max-width: 1200px; margin: 40px auto 0; padding-top: 20px; border-top: 1px solid #334155; font-size: 13px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <p>&copy; 2026 MedCare Hospital | All rights reserved.</p>
        <div>
            <a href="#" style="color: #94a3b8; text-decoration: none; margin-right: 15px;">Privacy Policy</a>
            <a href="#" style="color: #94a3b8; text-decoration: none;">Terms of Use</a>
        </div>
    </div>
</footer>


</form>

</body>
</html>
